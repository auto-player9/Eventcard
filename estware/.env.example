# Contact form delivery (optional).
# With RESEND_API_KEY set, messages from the contact form are emailed through Resend (https://resend.com).
# Without it, the form opens the visitor's email app with the message ready to send.
RESEND_API_KEY=
CONTACT_TO=support@estware.com
# Sender address on a domain you verified in Resend
CONTACT_FROM=Estware website <website@estware.com>
